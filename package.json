{
	"name": "@raygister/mcp",
	"version": "0.2.0",
	"description": "Read-only MCP server for the Raygister API. Lets AI assistants read construction projects, lots, specifications, locations and their amounts.",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"raygister",
		"architecture",
		"construction",
		"dpgf",
		"claude",
		"anthropic"
	],
	"homepage": "https://github.com/raygisterinc/mcp#readme",
	"bugs": {
		"url": "https://github.com/raygisterinc/mcp/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/raygisterinc/mcp.git"
	},
	"license": "MIT",
	"author": "Raygister",
	"type": "module",
	"bin": {
		"raygister-mcp": "dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"test": "vitest run",
		"smoke": "pnpm build && tsx scripts/smoke.ts",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^22.20.5",
		"tsup": "^9.0.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.33.0"
}
